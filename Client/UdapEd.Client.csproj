<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
	  <TargetFramework>net10.0</TargetFramework>
	  <Nullable>enable</Nullable>
	  <ImplicitUsings>enable</ImplicitUsings>
	  <InvariantGlobalization>false</InvariantGlobalization>
	  <BlazorWebAssemblyLoadAllGlobalizationData>false</BlazorWebAssemblyLoadAllGlobalizationData>
	  <BlazorWebAssemblyCultures>en</BlazorWebAssemblyCultures>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.14" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Shared\UdapEd.Shared.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Udap.CdsHooks.Model" Version="0.9.25" />
    <PackageReference Include="Udap.Common" Version="0.9.25" />
  </ItemGroup>
  <!--
    The default (partial) trim mode only trims assemblies marked trimmable, so these shipped whole to the browser.
    The browser build never calls BouncyCastle or Google Cloud Storage (they serve MAUI and server-side work through
    UdapEd.Shared), and AngleSharp is only reached through HtmlSanitizer. Trimming them saves about 2.2 MB brotli.
    Hl7.Fhir and Newtonsoft.Json are left whole: they serialize by reflection. This only affects the WebAssembly
    publish; the MAUI apps are unaffected.
  -->
  <ItemGroup>
    <TrimmableAssembly Include="BouncyCastle.Cryptography" />
    <TrimmableAssembly Include="Google.Apis" />
    <TrimmableAssembly Include="Google.Apis.Core" />
    <TrimmableAssembly Include="Google.Apis.Auth" />
    <TrimmableAssembly Include="Google.Apis.Storage.v1" />
    <TrimmableAssembly Include="Google.Cloud.Storage.V1" />
    <TrimmableAssembly Include="Google.Api.Gax" />
    <TrimmableAssembly Include="Google.Api.Gax.Rest" />
    <TrimmableAssembly Include="AngleSharp" />
    <TrimmableAssembly Include="AngleSharp.Css" />
  </ItemGroup>
  <!-- From:: https://jonhilton.net/visual-studio-2022-blazor-css-intellisense/ -->
  <Target Name="CollectMudBlazorStaticAssets" DependsOnTargets="ResolveStaticWebAssetsInputs" AfterTargets="Build" Condition=" '$(Configuration)' == 'Debug' ">
    <Copy SourceFiles="%(StaticWebAsset.Identity)" DestinationFolder="wwwroot/temp" Condition="$([System.String]::Copy(%(StaticWebAsset.Identity)).Contains('mudblazor'))" />
  </Target>
</Project>