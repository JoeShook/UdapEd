@* The UdapEd mark drawn inline so it follows the MudBlazor palette (light and dark).
   Source artwork: wwwroot/images/brand/udaped-mark.svg *@
<svg class="udaped-mark @Class" viewBox="0 0 64 64" width="@Size" height="@Size" aria-hidden="true" focusable="false">
    <path d="M20 24V37a12 12 0 0 0 24 0V24" fill="none" stroke="currentColor" stroke-width="6" />
    <circle class="udaped-mark-anchor" cx="20" cy="18" r="6" />
    <circle cx="44" cy="18" r="4.5" fill="none" stroke="currentColor" stroke-width="3" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 28;
    [Parameter] public string? Class { get; set; }
}
