@code {
    [Parameter]
    public string Class { get; set; } = string.Empty;

    [Parameter]
    public string RequestJson { get; set; } = string.Empty;

    [Parameter]
    public string ResponseJson { get; set; } = string.Empty;

    [Parameter]
    public string MessagesJson { get; set; } = string.Empty;
}

<MudPaper Class="@Class" Elevation="1" Style="display: flex; flex-direction: column; height: 100%;">
    <div style="flex: 1; display: flex; flex-direction: column; overflow: hidden;">
        <MudText Typo="Typo.h5" Class="my-4">CDS Developer Panel</MudText>

        <MudExpansionPanels MultiExpansion="true" Style="flex: 1; overflow: auto;">
            <MudExpansionPanel Text="Request" Expanded="true">
                <pre class="cds-json">@RequestJson</pre>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Response" Expanded="true">
                <pre class="cds-json">@ResponseJson</pre>
            </MudExpansionPanel>
            <MudExpansionPanel Text="Messages" Expanded="true">
                <pre class="cds-json">@MessagesJson</pre>
            </MudExpansionPanel>
        </MudExpansionPanels>
    </div>
</MudPaper>
